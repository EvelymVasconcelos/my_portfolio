# Rename this file to .env.local and fill in the values.

# Required only for the translation script (npm run translate)
# Get your key at: https://www.deepl.com/pro#developer
DEEPL_API_KEY=your_api_key_here

# Required for the contact form
# Get your free key at: https://resend.com/
RESEND_API_KEY=re_your_api_key_here

# Contact form: who receives the messages and who sends them.
# With the onboarding@resend.dev sender, Resend only delivers to the email of the account that owns the key.
CONTACT_TO_EMAIL=you@example.com
CONTACT_FROM_EMAIL="Portfólio <onboarding@resend.dev>"
